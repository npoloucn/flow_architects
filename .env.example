# Copia este archivo a .env y completa los valores desde el panel de Supabase.
# Dashboard -> Project Settings -> API (o API Keys).
# .env esta ignorado por git. Nunca pongas la service_role key aqui.

# URL del proyecto. Ej: https://fzlocerxiyneblglpoat.supabase.co
VITE_SUPABASE_URL=

# anon / public key (segura para el navegador, respeta RLS).
# NO es la service_role key.
VITE_SUPABASE_ANON_KEY=
