      "titulo": "Antifraude externo", "estado": "bloqueado",
      "descripcion": "Evaluación de riesgo en línea por un proveedor externo.\n\nBloqueado: falta el acceso al ambiente sandbox del proveedor.",
      "responsables": ["equipo-riesgo"], "posicion": { "x": 840, "y": 20 }, "colapsado": false,
      "creadoEn": "2026-11-06T09:10:00Z", "actualizadoEn": "2026-11-18T09:00:00Z"
    },
    {
      "id": "nd_idemstore", "parentId": "nd_api", "tipo": "basico", "categoria": "repo",
      "titulo": "Almacén de claves de idempotencia", "estado": "en-progreso",
      "descripcion": "Guarda clave, huella del cuerpo y respuesta durante 24 h.\n\n```sql\nCREATE TABLE idempotencia (\n  clave text PRIMARY KEY,\n  huella text NOT NULL,\n  respuesta jsonb,\n  expira_en timestamptz NOT NULL\n);\n```",
      "responsables": ["equipo-backend"], "posicion": { "x": 840, "y": 300 }, "colapsado": false,
      "creadoEn": "2026-11-07T09:00:00Z", "actualizadoEn": "2026-11-19T09:00:00Z"
